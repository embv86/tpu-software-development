# Этап 1: Сборка и запуск в режиме разработки
FROM node:20-alpine

WORKDIR /app

# Копируем файлы зависимостей
COPY package*.json ./

# Устанавливаем зависимости
RUN npm install

# Копируем весь код фронтенда
COPY . .

# Открываем порт, на котором работает Vite (по умолчанию 5173)
EXPOSE 5173

# Запускаем Vite с флагом --host, чтобы докер пропускал трафик наружу
CMD ["npm", "run", "dev", "--", "--host"]